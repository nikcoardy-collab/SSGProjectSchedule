# Copy to .env and adjust before running in production.
PORT=4000
NODE_ENV=production

# Required in production — sign-in tokens are signed with this.
JWT_SECRET=replace-with-a-long-random-string

# Only used the very first time the database is created.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ssg-admin

# Where ssg.db lives (defaults to ./data)
# DATA_DIR=/var/lib/ssg
