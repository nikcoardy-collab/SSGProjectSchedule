# Copy to .env for local development. On Vercel these are set as Environment
# Variables in the project settings instead.

# ── Supabase ────────────────────────────────────────────────────────────────
# Supabase dashboard → Project Settings → Database → Connection string.
#
# On Vercel use the TRANSACTION POOLER (port 6543) — serverless functions open and
# drop connections constantly and would exhaust a direct connection.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# For `npm run db:push` use the DIRECT connection (port 5432) instead — the
# transaction pooler cannot run the schema DDL:
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Optional: pin the Supabase CA certificate instead of trusting it unverified.
# SUPABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# ── App ─────────────────────────────────────────────────────────────────────
# Required in production — sign-in tokens are signed with this. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

NODE_ENV=production
PORT=4000

# Only used by `npm run db:push`, and only when no accounts exist yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ssg-admin
