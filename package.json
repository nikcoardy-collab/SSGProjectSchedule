{
  "name": "ssg-project-schedule",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SSG Project Schedule \u2014 collaborative project timeline for Solusi Golf Simulator",
  "scripts": {
    "dev": "concurrently -n api,web -c green,yellow \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "vercel-build": "npm --prefix client ci && npm --prefix client run build",
    "start": "NODE_ENV=production node server/index.js",
    "setup": "npm install && npm --prefix client install",
    "db:push": "node scripts/migrate.js",
    "seed:demo": "node scripts/seed-demo.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
